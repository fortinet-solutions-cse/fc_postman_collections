        {
          "name": "Create OU",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response) {\r",
                  "    // 1. Parse the JSON response body\r",
                  "    const responseData = pm.response.json();\r",
                  "    \r",
                  "    let orgId = null;\r",
                  "\r",
                  "    // 2. Safely check if orgUnits exists and has elements\r",
                  "    if (responseData.organizationUnits && \r",
                  "        responseData.organizationUnits.orgUnits && \r",
                  "        responseData.organizationUnits.orgUnits.length > 0) {\r",
                  "        \r",
                  "        // Grab the ID from the first item in the array\r",
                  "        orgId = responseData.organizationUnits.orgUnits[0].id;\r",
                  "    }\r",
                  "\r",
                  "    // 3. Store it in the requested environment variable name\r",
                  "    if (orgId !== null && orgId !== undefined) {\r",
                  "        pm.environment.set(\"target_org_id\", orgId);\r",
                  "        console.log(\"🚀 Successfully stored target_org_id: \" + orgId);\r",
                  "    } else {\r",
                  "        console.error(\"❌ Could not find 'id' inside the orgUnits array.\");\r",
                  "    }\r",
                  "} else {\r",
                  "    console.error(\"❌ No response received from the server.\");\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
