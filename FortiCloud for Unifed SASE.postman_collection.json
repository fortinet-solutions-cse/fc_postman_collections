    {
      "name": "04 - Create FortiCare Account",
      "item": [
        {
          "name": "Get Data for Account Creation",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// 1. Parse Fortinet's JSON response\r",
                  "const responseData = pm.response.json();\r",
                  "\r",
                  "const countries = responseData.organizationUnits.countries; \r",
                  "const sizes = responseData.organizationUnits.sizes;\r",
                  "\r",
                  "// ==========================================\r",
                  "// PART A: COUNTRY CODE & PHONE PREFIX HANDLING\r",
                  "// ==========================================\r",
                  "const userCountryChoice = pm.environment.get(\"selected_country_name\"); \r",
                  "const defaultCountryChoice = pm.environment.get(\"default_country_name\") || \"AF\"; \r",
                  "\r",
                  "let matchedCountry = null;\r",
                  "\r",
                  "// Search for the country by code (e.g., \"PG\")\r",
                  "if (userCountryChoice && userCountryChoice.trim() !== \"\") {\r",
                  "    matchedCountry = countries.find(c => \r",
                  "        c.code && c.code.toUpperCase() === userCountryChoice.trim().toUpperCase()\r",
                  "    );\r",
                  "}\r",
                  "\r",
                  "// Fallback if country code isn't found\r",
                  "if (!matchedCountry) {\r",
                  "    matchedCountry = countries.find(c => \r",
                  "        c.code && c.code.toUpperCase() === defaultCountryChoice.trim().toUpperCase()\r",
                  "    );\r",
                  "    if (matchedCountry) {\r",
                  "        console.warn(`⚠️ Country fallback used: \"${defaultCountryChoice.toUpperCase()}\"`);\r",
                  "    } else {\r",
                  "        console.error(`❌ Country Error: Default code \"${defaultCountryChoice}\" not found.`);\r",
                  "    }\r",
                  "}\r",
                  "\r",
                  "// Extract and save both Country ID and its specific Phone Prefix\r",
                  "if (matchedCountry) {\r",
                  "    pm.environment.set(\"current_country_id\", matchedCountry.id);\r",
                  "    \r",
                  "    // Grab the first phone code array item (e.g., \"+675\")\r",
                  "    const phonePrefix = (matchedCountry.phone_codes && matchedCountry.phone_codes.length > 0) \r",
                  "        ? matchedCountry.phone_codes[0] \r",
                  "        : \"\";\r",
                  "    pm.environment.set(\"current_phone_prefix\", phonePrefix);\r",
                  "    \r",
                  "    console.log(`✅ Country ID: ${matchedCountry.id} | Dynamic Phone Prefix: ${phonePrefix}`);\r",
                  "}\r",
                  "\r",
                  "// ==========================================\r",
                  "// PART B: COMPANY SIZE HANDLING\r",
                  "// ==========================================\r",
                  "const userSizeChoice = pm.environment.get(\"companysize\");\r",
                  "const defaultSizeChoice = pm.environment.get(\"default_companysize\") || \"1-24\"; \r",
                  "\r",
                  "let matchedSize = null;\r",
                  "\r",
                  "if (userSizeChoice && userSizeChoice.trim() !== \"\") {\r",
                  "    const cleanUserChoice = userSizeChoice.trim().replace(/\\s+/g, '');\r",
                  "    matchedSize = sizes.find(s => s.name.replace(/\\s+/g, '') === cleanUserChoice);\r",
                  "}\r",
                  "\r",
                  "if (matchedSize) {\r",
                  "    pm.environment.set(\"current_size_id\", matchedSize.id);\r",
                  "    console.log(`✅ Size: Found ID for \"${userSizeChoice}\": ${matchedSize.id}`);\r",
                  "} else {\r",
                  "    const cleanDefaultChoice = defaultSizeChoice.trim().replace(/\\s+/g, '');\r",
                  "    const fallbackSize = sizes.find(s => s.name.replace(/\\s+/g, '') === cleanDefaultChoice);\r",
                  "    \r",
                  "    if (fallbackSize) {\r",
                  "        pm.environment.set(\"current_size_id\", fallbackSize.id);\r",
                  "        console.warn(`⚠️ Size fallback used: \"${defaultSizeChoice}\" (ID: ${fallbackSize.id})`);\r",
                  "    } else {\r",
                  "        console.error(`❌ Size Error: Predefined default range \"${defaultSizeChoice}\" not found.`);\r",
                  "    }\r",
                  "}\r",
                  "\r",
                  "// ==========================================\r",
                  "// OPTIONAL SANITIZATION BONUS\r",
                  "// ==========================================\r",
                  "// Strips accidental \"+\" signs or country codes if the user included them in their phone field\r",
                  "let absolutePhone = pm.environment.get(\"companyPhone\") || \"\";\r",
                  "if (absolutePhone) {\r",
                  "    // If it starts with a +, remove it so it doesn't double-up with your dynamic prefix\r",
                  "    absolutePhone = absolutePhone.trim().replace(/^\\+/, '').replace(/\\s+/g, '');\r",
                  "    pm.environment.set(\"clean_company_phone\", absolutePhone);\r",
                  "}\r",
                  "\r",
                  "Yo"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokeniam}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "https://support.fortinet.com/ES/api/iam/v1/accounts/getcommondata",
              "protocol": "https",
              "host": [
                "support",
                "fortinet",
                "com"
              ],
              "path": [
                "ES",
                "api",
                "iam",
                "v1",
                "accounts",
                "getcommondata"
              ]
            }
          },
          "response": []
        },
