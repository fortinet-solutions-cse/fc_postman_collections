              "protocol": "https",
              "host": [
                "support",
                "fortinet",
                "com"
              ],
              "path": [
                "ES",
                "api",
                "fortiflex",
                "v2",
                "configs",
                "create"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Create Flex Entitlement",
          "request": {
            "auth": {
