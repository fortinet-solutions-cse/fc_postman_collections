        {
          "name": "1b - Get root accountId from root_org_id",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('token')) {",
                  "    throw new Error('No token: run \"1 - Login FortiCloud IAM\" first.');",
                  "}",
                  "if (!pm.collectionVariables.get('root_org_id')) {",
                  "    throw new Error('root_org_id is empty: set it in the collection variables.');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('accounts/list returned 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "console.log('accounts/list response:', JSON.stringify(body));",
                  "",
                  "// Find the array of accounts, wherever the API puts it",
                  "let list = [];",
                  "if (Array.isArray(body)) list = body;",
                  "else if (Array.isArray(body.accounts)) list = body.accounts;",
                  "else if (Array.isArray(body.accountList)) list = body.accountList;",
                  "else if (Array.isArray(body.data)) list = body.data;",
                  "else if (Array.isArray(body.result)) list = body.result;",
                  "",
                  "const idOf = (a) => a.id ?? a.accountId ?? a.account_id;",
                  "",
                  "// Prefer an account explicitly flagged as root, otherwise take the only one",
                  "let root = list.find(a => a.isRoot === true || a.root === true || a.isRootAccount === true",
                  "                      || String(a.type || a.accountType || '').toLowerCase().includes('root'));",
                  "if (!root && list.length === 1) root = list[0];",
                  "",
                  "if (root && idOf(root) !== undefined) {",
                  "    pm.collectionVariables.set('rootaccountId', String(idOf(root)));",
                  "    console.log('rootaccountId saved:', idOf(root));",
                  "} else {",
                  "    console.warn('Could not pick the root account automatically (' + list.length + ' accounts returned). Check the response above and set rootaccountId by hand.');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"parentId\": {{root_org_id}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{org_base_url}}/accounts/list",
              "host": [
                "{{org_base_url}}"
              ],
              "path": [
                "accounts",
                "list"
              ]
            }
          },
          "response": []
        },
