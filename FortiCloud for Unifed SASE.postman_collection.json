    {
      "name": "06 - FortFlex FortiSASE license creation",
      "item": [
        {
          "name": "Create Flex Config",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "let parametersArray = [\r",
                  "    { \"id\": 48, \"value\": pm.environment.get(\"flexnumberofusers\") },\r",
                  "    { \"id\": 49, \"value\": pm.environment.get(\"flexservicepackage\") }\r",
                  "];\r",
                  "\r",
                  "// 2. Helper function to check if a variable has a valid, non-null, non-zero value\r",
                  "function isValidValue(val) {\r",
                  "    if (val === null || val === undefined) return false;\r",
                  "    const cleanVal = String(val).trim();\r",
                  "    return cleanVal !== \"\" && cleanVal !== \"0\";\r",
                  "}\r",
                  "\r",
                  "// 3. Define the optional parameters to check\r",
                  "const optionalParams = [\r",
                  "    { id: 51, envKey: \"flexdedicatedip\" },\r",
                  "    { id: 100, envKey: \"flexdatatransfer\" },\r",
                  "    { id: 101, envKey: \"flexonrampcloud\" },\r",
                  "    { id: 102, envKey: \"flexonrampftn\" },\r",
                  "    { id: 104, envKey: \"flexaddcomputecloud\" },\r",
                  "    { id: 105, envKey: \"flexaddcomputeftn\" }\r",
                  "];\r",
                  "\r",
                  "// 4. Dynamically append only the valid optional parameters\r",
                  "optionalParams.forEach(param => {\r",
                  "    const val = pm.environment.get(param.envKey);\r",
                  "    if (isValidValue(val)) {\r",
                  "        parametersArray.push({ \"id\": param.id, \"value\": String(val).trim() });\r",
                  "    }\r",
                  "});\r",
                  "\r",
                  "// 5. Construct the final object payload\r",
                  "const payload = {\r",
                  "    \"programSerialNumber\": pm.environment.get(\"flexprogramserialnumber\"),\r",
                  "    \"accountId\": Number(pm.environment.get(\"customer_account_id\")),\r",
                  "    \"name\": pm.environment.get(\"flexconfigname\"),\r",
                  "    \"productTypeId\": 205,\r",
                  "    \"parameters\": parametersArray\r",
                  "};\r",
                  "\r",
                  "// 6. Serialize the payload into a temporary string variable for the request body\r",
                  "pm.variables.set(\"dynamic_flex_payload\", JSON.stringify(payload));"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response) {\r",
                  "    const responseData = pm.response.json();\r",
                  "    let configId = null;\r",
                  "    \r",
                  "    // Drill into the array structure safely\r",
                  "    if (responseData.configs) {\r",
                  "        if (Array.isArray(responseData.configs) && responseData.configs.length > 0) {\r",
                  "            configId = responseData.configs[0].id;\r",
                  "        } else if (responseData.configs.id) {\r",
                  "            configId = responseData.configs.id;\r",
                  "        }\r",
                  "    }\r",
                  "    \r",
                  "    if (configId) {\r",
                  "        pm.environment.set(\"flexconfigid\", configId);\r",
                  "        console.log(`🚀 Successfully parsed array! Saved flexconfigid: ${configId}`);\r",
                  "    } else {\r",
                  "        console.error(\"❌ Could not extract ID from the configs array.\");\r",
                  "    }\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenflex}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{{dynamic_flex_payload}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
